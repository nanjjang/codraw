{
  "name": "repogram",
  "displayName": "Repogram",
  "description": "Explore code structure, inspect change impact, find related tests, and review Git changes without leaving VS Code.",
  "version": "0.1.5",
  "publisher": "nanjjang",
  "preview": true,
  "pricing": "Free",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0E639C",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nanjjang/repogram.git"
  },
  "bugs": {
    "url": "https://github.com/nanjjang/repogram/issues"
  },
  "homepage": "https://github.com/nanjjang/repogram#readme",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "architecture",
    "diagram",
    "dependency graph",
    "database",
    "erd",
    "mongodb",
    "nosql",
    "mongoose",
    "visualization",
    "change impact",
    "developer tools",
    "test navigation",
    "code review"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onView:repogram.overview",
    "onWebviewPanel:repogram.diagram"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "repogram",
          "title": "Repogram",
          "icon": "media/repogram.svg"
        }
      ]
    },
    "views": {
      "repogram": [
        {
          "id": "repogram.overview",
          "name": "Overview",
          "type": "webview",
          "contextualTitle": "Repogram"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "repogram.open",
          "when": "view == repogram.overview",
          "group": "navigation"
        },
        {
          "command": "repogram.reviewChanges",
          "when": "view == repogram.overview",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "repogram.showFileImpact",
          "when": "resourceScheme == file || resourceScheme == vscode-remote",
          "group": "8_repogram@0"
        },
        {
          "command": "repogram.findRelatedTests",
          "when": "resourceScheme == file || resourceScheme == vscode-remote",
          "group": "8_repogram@1"
        }
      ],
      "explorer/context": [
        {
          "command": "repogram.showFileImpact",
          "when": "resourceScheme == file || resourceScheme == vscode-remote",
          "group": "8_repogram@0"
        },
        {
          "command": "repogram.findRelatedTests",
          "when": "resourceScheme == file || resourceScheme == vscode-remote",
          "group": "8_repogram@1"
        }
      ]
    },
    "commands": [
      {
        "command": "repogram.open",
        "title": "Repogram: Open Workspace Diagram",
        "category": "Repogram",
        "icon": "$(graph)"
      },
      {
        "command": "repogram.refresh",
        "title": "Repogram: Refresh Workspace Diagram",
        "category": "Repogram",
        "enablement": "repogram.panelOpen"
      },
      {
        "command": "repogram.exportSchemaDocs",
        "title": "Repogram: Export Schema Documentation",
        "category": "Repogram",
        "icon": "$(export)"
      },
      {
        "command": "repogram.showFileImpact",
        "title": "Repogram: Show File Impact",
        "category": "Repogram",
        "icon": "$(references)"
      },
      {
        "command": "repogram.reviewChanges",
        "title": "Repogram: Review Working Changes",
        "category": "Repogram",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "repogram.findRelatedTests",
        "title": "Repogram: Find Related Tests",
        "category": "Repogram",
        "icon": "$(beaker)"
      },
      {
        "command": "repogram.copyChangeReview",
        "title": "Repogram: Copy Change Review",
        "category": "Repogram",
        "icon": "$(copy)"
      }
    ],
    "configuration": {
      "title": "Repogram",
      "properties": {
        "repogram.maxFiles": {
          "type": "number",
          "default": 10000,
          "minimum": 100,
          "maximum": 20000,
          "description": "Maximum number of supported source and configuration files indexed in one scan."
        },
        "repogram.maxFileSizeKb": {
          "type": "number",
          "default": 1024,
          "minimum": 16,
          "maximum": 10240,
          "description": "Maximum size of an individual text file analyzed, in KiB."
        },
        "repogram.exclude": {
          "type": "string",
          "default": "**/{node_modules,.git,.hg,.svn,dist,dist-test,build,out,coverage,.next,.nuxt,.svelte-kit,target,vendor,.venv,venv,__pycache__,.turbo,.nx,.cache,.parcel-cache,.gradle,.pnpm-store,.yarn,.vercel,.output,.angular,.dart_tool,.vscode-test,.vscode-test-web,bin,obj}/**",
          "description": "Glob pattern excluded from workspace analysis. The default skips dependency, build and tool-cache directories, which otherwise outnumber a project's own files and dominate the structure view."
        },
        "repogram.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Refresh an open diagram after relevant workspace files change."
        },
        "repogram.followActiveEditor": {
          "type": "boolean",
          "default": true,
          "description": "Mark the module and file of the active editor in the overview and the diagram, so a diagram kept open beside the code follows what you are editing."
        }
      }
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "compile": "npm run check-types && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/tests/*.test.js",
    "test:extension-host": "npm run compile && tsc -p tsconfig.test.json && node tests/run-extension-test.mjs",
    "check": "npm run check-types && npm run lint && npm test && node esbuild.mjs --production",
    "check:full": "npm run check && npm run test:extension-host",
    "package": "npm run check-types && node esbuild.mjs --production",
    "vscode:prepublish": "npm run package",
    "vsix": "npm run package && vsce package",
    "publish:marketplace": "npm run check && vsce publish"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "@types/vscode": "~1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "sharp": "^0.35.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@vscode/vsce-sign@2.1.0": true
  }
}
